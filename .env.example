# local | dev | prod — влияет только на формат логов
ENV=local

# Порт HTTP-сервера. 8085 занят канбаном, 8086 уведомлениями,
# 8087 external-api, 8088 ИИ-прокси.
SERVER_PORT=8089

# Файл SQLite и корень для mp3. Оба лежат внутри проекта: том ./:/app
# уже прокинут в docker-compose, отдельные volume не нужны.
DB_PATH=./data/voicemail.db
AUDIO_DIR=./audio

# Голосовая почта Asterisk. Токен — из /etc/vmapi.env на сервере АТС.
VMAPI_URL=http://192.168.0.1:8080
VMAPI_TOKEN=
VMAPI_TIMEOUT_SECONDS=60

# Сколько обращений просить у АТС за один запрос. Потолок задан на её стороне
# (VMAPI_MAX_MESSAGES=50). Остаток дозабирается циклом, пока truncated=true.
VMAPI_LIMIT=20

# Времена ночного забора через запятую, например 03:30.
#
# Время МЕСТНОЕ — берётся из таймзоны контейнера (TZ=Europe/Moscow в
# docker-compose.yml). Проверить, что применилось, можно по строке в логе при
# старте: «Следующий забор обращений at=...» — там будет смещение +03:00.
#
# ПУСТОЕ ЗНАЧЕНИЕ ВЫКЛЮЧАЕТ РАСПИСАНИЕ — так и оставить до переезда фронта.
# Первый же ack начнёт вычищать INBOX на АТС, и действующая страница портала,
# которая читает живой INBOX, опустеет. Пока фронт не переехал, работаем
# только руками: ./main -sync -no-ack
POLL_AT=
